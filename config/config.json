{
    "application": {
        "name": "LAMESE AI",
        "version": "0.1.0",
        "environment": "development"
    },
    "logging": {
        "level": "INFO",
        "directory": "logs",
        "filename": "app.log"
    },
    "data": {
        "dataset_path": "datasets/heart_disease.csv",
        "test_size": 0.2,
        "random_state": 42
    },

    "model": {
    "type": "random_forest",
    "n_estimators": 100,
    "random_state": 42,
    "model_output_path": "artifacts/model.pkl",
    "threshold": {
        "minimum_recall": 0.90,
        "minimum": 0.30,
        "maximum": 0.70,
        "step": 0.01
    }
}
}